pros::MotorGroup BottomGoalOutake({-1,10}, pros::MotorGearset::blue);

pros::Rotation horizontal_encoder(14);

pros::Rotation vertical_encoder(17);

lemlib::TrackingWheel horizontal_tracking_wheel(&horizontal_encoder, lemlib::Omniwheel::NEW_2, 0);
lemlib::TrackingWheel vertical_tracking_wheel(&vertical_encoder, lemlib::Omniwheel::NEW_2, 0);

bool matchloader = false; 
bool descore = false;
bool pto = false;
bool middlegoal = false;
bool lowgoal = false;
