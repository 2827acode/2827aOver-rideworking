void opcontrol() {
    chassis.cancelAllMotions();
    chassis.setPose(0, 0, 0);

    bool runningSequence = false;
    bool inHoldMode = false;

    int sequenceStart = 0;
    bool step2_done = false;
    bool step3_done = false;
    bool step4_done = false;

    bool air5TimerActive = false;
    int air5TimerStart = 0;
    bool wasL2Held = false;

    while (true) {
        int dir = master.get_analog(ANALOG_LEFT_Y);
        int turn = master.get_analog(ANALOG_RIGHT_X);

        left_mg.move(dir + turn);
        right_mg.move(dir - turn);

        bool l2Held = master.get_digital(DIGITAL_L2);

        // Start L2 sequence
        if (master.get_digital_new_press(DIGITAL_L2)) {
            runningSequence = true;
            inHoldMode = false;

            sequenceStart = pros::millis();
            step2_done = false;
            step3_done = false;
            step4_done = false;

            air5TimerActive = false;

            IntakeAndOuttake.move(127);
            air3.set_value(false);
        }

        // Timed sequence
        if (runningSequence) {
            int t = pros::millis() - sequenceStart;

            if (t >= 250 && !step2_done) {
                air3.set_value(true);
                air5.set_value(true);
                step2_done = true;
            }

            if (t >= 275 && !step3_done) {
                BottomGoalOutake.move(100);
                step3_done = true;
            }

            if (t >= 625 && !step4_done) {
                runningSequence = false;
                inHoldMode = true;
                step4_done = true;
            }
        }

        // Hold mode
        if (inHoldMode && !runningSequence) {
            BottomGoalOutake.move(45);

            if (l2Held) {
                BottomGoalOutake.move(65);
                air5TimerActive = false;
            } else {
                IntakeAndOuttake.move(0);
                air5TimerActive = true;

                if (wasL2Held) {
                    air5TimerActive = true;
                    air5TimerStart = pros::millis();
                }
            }

            if (air5TimerActive && pros::millis() - air5TimerStart >= 1000) {
                air5.set_value(false);
                air5TimerActive = false;
            }
        }

        // Manual controls
        if (!runningSequence) {
            if (master.get_digital(DIGITAL_L1)) {
                air5.set_value(false);
                inHoldMode = false;
                air5TimerActive = false;
                air3.set_value(true);
                pto = true;
                IntakeAndOuttake.move(127);
            }
            else if (master.get_digital(DIGITAL_R1)) {
                air5.set_value(false);
                inHoldMode = false;
                air5TimerActive = false;
                air3.set_value(false);
                pto = false;
                IntakeAndOuttake.move(127);
            }
            else if (master.get_digital(DIGITAL_R2)) {
                air5.set_value(false);
                inHoldMode = false;
                air5TimerActive = false;
                air4.set_value(true);
                middlegoal = true;
                air3.set_value(false);
                pto = false;
                IntakeAndOuttake.move(85);
            }
            else if (master.get_digital_new_press(DIGITAL_X)) {
                matchloader = !matchloader;
                air2.set_value(matchloader);
                air5.set_value(false);
            }
            else if (master.get_digital(DIGITAL_Y)) {
                inHoldMode = false;
                air5TimerActive = false;
                air.set_value(false);
                descore = false;
                BottomGoalOutake.move(0);
                air5.set_value(false);
            }
            else if (master.get_digital(pros::E_CONTROLLER_DIGITAL_RIGHT)) {
                air3.set_value(true);
                pto = true;
                BottomGoalOutake.move(65);
                air5.set_value(false);
            }
            else if (!inHoldMode) {
                IntakeAndOuttake.move(0);
                BottomGoalOutake.move(0);
                air4.set_value(false);
                middlegoal = false;
                air.set_value(true);
                descore = true;
            }
        }

        wasL2Held = l2Held;
        pros::delay(20);
    }
}

